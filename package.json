{
  "name": "traceandback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native development timeline with safe Git recovery",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "check": "tsc --noEmit",
    "start": "node --import tsx src/cli.ts start",
    "test": "node --import tsx --test test/index.test.ts",
    "trace": "node --import tsx src/cli.ts start",
    "trace:start": "node --import tsx src/cli.ts start",
    "prototype": "node prototype/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
